# ------------------------------------------------------------------
# GoodCryptoX — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# ------------------------------------------------------------------

# Public base URL of the deployed site (used in verification links, emails).
APP_URL="https://goodcryptox.tech"

# --- Database -----------------------------------------------------
# Default: SQLite (no external DB server needed). The relative path is resolved
# against the prisma/ directory, so this file lives at prisma/dev.db.
DATABASE_URL="file:./dev.db"
# For PostgreSQL instead, use e.g.:
# DATABASE_URL="postgresql://user:password@localhost:5432/goodcryptox?schema=public"

# --- Cryptography -------------------------------------------------
# 32-byte key, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used for AES-256-GCM encryption of sensitive data at rest and test bundles.
DATA_ENCRYPTION_KEY=""

# Secret used to sign session cookies and verification tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=""

# --- Email (single Hostinger business mailbox) --------------------
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
# The one business mailbox (login + password created in Hostinger hPanel).
SMTP_USER="event@goodcryptox.tech"
SMTP_PASS=""

# From-address used for ALL outgoing mail (verification, contracts, etc.).
MAIL_FROM="GoodCryptoX <event@goodcryptox.tech>"
# Where contract/CEO-meeting approvals are reviewed before sending.
HIRING_REVIEW_INBOX="event@goodcryptox.tech"

# --- AI (DeepSeek, OpenAI-compatible API) -------------------------
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
# deepseek-chat supports tool calling (used by the assessor). Do not use
# deepseek-reasoner here — it does not support function calling.
DEEPSEEK_MODEL="deepseek-chat"

# --- Social login (OAuth) -----------------------------------------
# Each provider appears on the sign-in/up pages only when BOTH its id and
# secret are set. Register OAuth apps with each provider and set the redirect
# (callback) URL to: {APP_URL}/api/auth/oauth/{provider}/callback
# e.g. https://goodcryptox.tech/api/auth/oauth/google/callback
#
# NOTE: social login never bypasses the password. New users SET a password
# after the provider verifies their email; returning users RE-ENTER it.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
# Twitter/X uses OAuth 2.0 with PKCE. It does NOT return an email, so new users
# enter their email on the password step and verify it via our email flow.
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# --- Hiring workflow ----------------------------------------------
# When "true", a contract is drafted and queued for human approval
# before it is emailed. When "false", the AI sends it autonomously.
REQUIRE_CONTRACT_APPROVAL="true"
# Company signatory shown on generated contracts.
COMPANY_SIGNATORY_NAME="Jonathan Siles"
COMPANY_SIGNATORY_TITLE="CEO, GoodCryptoX"
CEO_CALENDAR_LINK="https://cal.com/goodcryptox-ceo"
